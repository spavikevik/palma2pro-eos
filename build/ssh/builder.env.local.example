# Copy to builder.env.local (gitignored) and edit.
#
#     cp build/ssh/builder.env.local.example build/ssh/builder.env.local
#
# Sourced before builder.env, which uses ${VAR:-default}, so anything set here
# wins over the repo defaults.
#
# Use the ${VAR:-value} form below, not a plain assignment. A plain assignment
# would override an exported variable too, which breaks one-off overrides:
#
#     BUILDER_HOST=other-machine scripts/builder.sh ssh
#
# Precedence, with this form:  exported var  >  this file  >  builder.env
#
# Kept out of git because the address is machine specific, and because the
# pinned host key in build/ssh/known_hosts is tied to it.

BUILDER_HOST=${BUILDER_HOST:-my-builder.example.ts.net}
# BUILDER_PORT=${BUILDER_PORT:-2222}
# BUILDER_KEY=${BUILDER_KEY:-$HOME/.ssh/palma2pro-builder}
