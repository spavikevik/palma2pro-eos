<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="foundation.e.blisslauncher.eink">
    <!-- targetPackage is the launcher's real package name, which is
         foundation.e.blisslauncher - NOT foundation.e.blisslauncher3, which is
         only what the prebuilt directory and the privapp allowlist are called. -->
    <overlay android:targetPackage="foundation.e.blisslauncher"
             android:isStatic="true"
             android:priority="1000" />
    <!--
      Priority MUST exceed /e/OS's own foundation.e.blisslauncher.overlay, which
      declares 100. Overlays are applied in priority order and the last one wins,
      so at priority 1 this overlay was applied first and then overwritten - it
      reported STATE_ENABLED the whole time while doing nothing.
    -->
    <application android:hasCode="false" />
</manifest>
