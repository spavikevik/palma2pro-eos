// Runtime resource overlay: give DeskClock a static launcher icon.
//
// DeskClock's manifest declares com.android.launcher3.LEVEL_PER_TICK_ICON_ROUND
// and friends, which makes Launcher3 (and so BlissLauncher) render its icon as a
// LIVE analog clock via ClockDrawableWrapper. The second hand sweeps once a
// second, and on this panel each tick costs a full-screen refresh -- measured as
// the only thing repainting the launcher at idle.
//
// The metadata cannot be overridden by an RRO, but the icon it points at can.
// ClockDrawableWrapper only engages for an adaptive icon with the layer indices
// the metadata names; a flat bitmap makes it fall back to a static icon.
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

runtime_resource_overlay {
    name: "DeskClockStaticIconOverlay",
    theme: "DeskClockStaticIcon",
    sdk_version: "current",
    product_specific: true,
}
