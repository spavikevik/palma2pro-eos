// QcRilAm -- the client that was missing from this device.
//
// Vendored from sonyxperiadev/QcRilAm, Apache-2.0. See PROVENANCE.md. Upstream
// is unmodified except for the two build changes noted below, both forced by
// this device rather than by taste.
//
// WHAT IT IS FOR
// --------------
// qcrild registers vendor.qti.hardware.radio.am@1.0::IQcRilAudio and waits for
// a client to call setCallback. When a call goes active it pushes
// "vsid=...;call_state=2" through that callback, and only then does the audio
// HAL open the VoiceMMode PCMs. Onyx shipped no such client, so calls connected
// with no audio in either direction. See docs/23-volte.md.

// Upstream declares `subdirs = ["interface"]`. Soong removed subdirs; Android.bp
// files are discovered on their own, so it is dropped rather than ported.

hidl_package_root {
    name: "vendor.qti.hardware.radio.am",
    // Must name the directory the .hal files actually live in. Upstream expects
    // vendor/oss/qcrilam; ours rides along in the device tree, because that is
    // the only thing scripts/sync-to-builder.sh places on the builder.
    path: "device/onyx/Palma2_Pro_C/qcrilam/interface/am",
}

android_app {
    name: "QcRilAm",
    certificate: "platform",

    // Upstream sets `proprietary: true`, which installs to /vendor/app. We never
    // flash vendor on this device -- it is stock Onyx and stays that way -- so
    // this goes to system_ext instead. It is framework-side code anyway: it
    // holds a HIDL client on one end and AudioManager on the other.
    system_ext_specific: true,

    srcs: ["src/**/*.kt"],

    static_libs: ["vendor.qti.hardware.radio.am-V1.0-java"],

    sdk_version: "system_current",
}
