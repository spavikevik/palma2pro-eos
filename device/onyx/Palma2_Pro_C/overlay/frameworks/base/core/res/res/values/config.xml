<?xml version="1.0" encoding="utf-8"?>
<!--
  E-ink oriented defaults. The panel is 824x1648 and every animation costs a
  visible refresh, so animations are disabled rather than merely shortened.
-->
<resources>
    <!-- Wallpaper service ENABLED.
         It was disabled here on the theory that "a static image forces
         full-screen refreshes". That was wrong: a static wallpaper is drawn
         once like any other layer and costs nothing extra to hold on screen --
         only *live* wallpapers refresh continuously. Disabling the service
         instead left SystemServer logging "Wallpaper service disabled by
         config", no wallpaper settable at all, and a BLACK background, which is
         the worst case on e-ink: maximum ink, poor contrast.
         Pair this with a live wallpaper at your peril; a static one is free. -->
    <bool name="config_enableWallpaperService">true</bool>

    <!-- E-ink cannot usefully animate; leaving these on causes constant
         partial refreshes and heavy ghosting. -->
    <bool name="config_disableTransitionAnimation">true</bool>

    <!-- No auto-brightness: this panel's frontlight is warm/cold LEDs driven
         through /sys/class/backlight/onyx_bl_{br,ct}, not a standard sensor
         backed backlight. -->
    <bool name="config_automatic_brightness_available">false</bool>
</resources>
