+    /**
+     * Re-read every temperature from the HAL and recompute the aggregate status.
+     *
+     * Stock only recomputes the aggregate in two places: once when the HAL connects, and
+     * whenever the HAL pushes a change through IThermalChangedCallback. On this device the
+     * HAL does not push, so the system thermal status was whatever it happened to be at
+     * connect time and never moved again -- while dumpsys kept displaying live polled
+     * temperatures beside it, which is what made it look like a stuck sensor rather than a
+     * stale aggregate.
+     *
+     * The consequence was not cosmetic. JobScheduler's ThermalStatusRestriction refuses to
+     * run non-expedited jobs at THROTTLING_SEVERE, so a status frozen at SEVERE meant
+     * DownloadManager never transferred a byte and no app could be installed from any
+     * source, indefinitely and silently. Restarting the thermal HAL "fixed" it only because
+     * that forces a reconnect, which re-runs the connect path. See issue #15.
+     *
+     * Polling is cheap: getCurrentTemperatures() on a handful of sensors, every 30s by
+     * default, on the shared background thread.
+     */
+    private void epdcPollHalAndRecompute() {
+        synchronized (mLock) {
+            if (mHalWrapper == null || !mHalReady.get()) {
+                return;
+            }
+            final List<Temperature> temperatures = mHalWrapper.getCurrentTemperatures(false, 0);
+            if (temperatures == null || temperatures.isEmpty()) {
+                return;
+            }
+            final int count = temperatures.size();
+            for (int i = 0; i < count; i++) {
+                // sendCallback=false: update the map without recomputing per entry, then
+                // recompute once below, exactly as the connect path does.
+                onTemperatureChanged(temperatures.get(i), false);
+            }
+            onTemperatureMapChangedLocked();
+        }
+    }
+
+    private void epdcStartThermalPolling() {
+        final long interval = epdcPollIntervalMs();
+        if (interval <= 0) {
+            return;
+        }
+        BackgroundThread.getHandler().removeCallbacks(mEpdcThermalPoll);
+        BackgroundThread.getHandler().postDelayed(mEpdcThermalPoll, interval);
+    }
