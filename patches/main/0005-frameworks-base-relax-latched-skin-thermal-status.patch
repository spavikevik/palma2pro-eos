+    private final Runnable mEpdcThermalPoll = new Runnable() {
+        @Override
+        public void run() {
+            epdcPollHalAndRecompute();
+            final long next = epdcPollIntervalMs();
+            if (next > 0) {
+                BackgroundThread.getHandler().postDelayed(this, next);
+            }
+        }
+    };
