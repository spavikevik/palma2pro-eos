+    private static long epdcPollIntervalMs() {
+        final int seconds = SystemProperties.getInt("persist.sys.thermal.poll_seconds",
+                DEFAULT_THERMAL_POLL_SECONDS);
+        return seconds <= 0 ? 0L : seconds * 1000L;
+    }
