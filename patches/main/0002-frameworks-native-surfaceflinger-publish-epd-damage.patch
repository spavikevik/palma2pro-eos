+
+namespace {
+
+// Publish SurfaceFlinger's dirty region for the EPD composer shim.
+//
+// The e-ink panel refreshes per rectangle, but nothing in the normal stack can
+// carry that information down: the DRM planes expose no FB_DAMAGE_CLIPS, and
+// this panel requires client composition, which leaves a single full-screen
+// plane whose CRTC rect is always the whole display. Without this, the shim has
+// to refresh all 1648x824 pixels for a single changed character -- slow, and it
+// ghosts the whole panel instead of one region. See docs/11.
+//
+// Single writer here, single reader in libepdcshim.so, no locking: a seqlock.
+// Both sides sit on the frame path, so neither may block the other.
+epdc_damage_shm* epdcDamageMap() {
+    static epdc_damage_shm* sMap = []() -> epdc_damage_shm* {
+        int fd = open(EPDC_DAMAGE_PATH, O_RDWR | O_CREAT | O_CLOEXEC, 0660);
+        if (fd < 0) {
+            ALOGI("epdc: no damage map (%s): %s", EPDC_DAMAGE_PATH, strerror(errno));
+            return nullptr;
+        }
+        if (ftruncate(fd, 4096) != 0) {
+            ALOGW("epdc: ftruncate failed: %s", strerror(errno));
+            close(fd);
+            return nullptr;
+        }
+        void* m = mmap(nullptr, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        close(fd);
+        if (m == MAP_FAILED) {
+            ALOGW("epdc: mmap failed: %s", strerror(errno));
+            return nullptr;
+        }
+
+        auto* s = static_cast<epdc_damage_shm*>(m);
+        // Ask for one full pass first: what is currently on the panel is
+        // unknown here, so honouring damage alone would leave stale pixels.
+        s->count = 0;
+        s->full = 1;
+        s->version = EPDC_DAMAGE_VERSION;
+        __atomic_store_n(&s->seq, 2u, __ATOMIC_RELAXED);
+        // magic last, with release ordering: the reader must never attach to a
+        // half-initialised mapping.
+        __atomic_store_n(&s->magic, EPDC_DAMAGE_MAGIC, __ATOMIC_RELEASE);
+        ALOGI("epdc: publishing damage to %s", EPDC_DAMAGE_PATH);
+        return s;
+    }();
+    return sMap;
+}
+
+
+// ===========================================================================
+// Per-layer damage for the e-ink panel. See docs/15.
+//
+// Refresh cost on this panel is proportional to AREA, so the question this
+// function answers -- "what actually changed?" -- decides how the whole device
+// feels. Output::getDirtyRegion() answers a coarser question: it is the union
+// across every layer, so one sweeping clock hand comes back as the full panel
+// and 1.36M pixels get repainted for 30x50 of real change.
+//
+// So walk the layers and ask each one. Three separate things require a
+// repaint, and missing any of them leaves stale pixels -- which on e-ink are
+// permanent, because there is no next scanout to correct them:
+//
+//   1. contents changed     -> the layer's own surfaceDamage
+//   2. coverage changed     -> moved or resized: union of OLD and NEW coverage
+//   3. the layer went away  -> its LAST coverage, which only we still remember
+//
+// (2) and (3) are why "just union the surface damage" is not enough: a window
+// that moves without redrawing reports EMPTY surface damage, and a window that
+// was destroyed reports nothing at all. Both leave their old pixels behind.
+//
+// Everything here is in OUTPUT space, because outputSpaceVisibleRegion is
+// already transformed for us. That is deliberate: the layer->output->display
+// transform chain is the easiest thing on this device to get subtly wrong
+// (docs/15 section 6, and it is how the panel ends up refreshing a
+// plausible-looking but wrong rectangle). This avoids doing it by hand at all.
+// It is also the VISIBLE region, so pixels behind an opaque window on top are
+// correctly not refreshed.
+//
+// surfaceDamage encoding, from LayerSnapshot.cpp::updateSurfaceDamage():
+//     no new buffer     -> empty region
+//     forceFullDamage   -> Region::INVALID_REGION
+//     otherwise         -> the client's own damage rects
+//
+// The trap: INVALID_REGION is Region(Rect{0,0,-1,-1}), and Rect::isEmpty() is
+// (width <= 0 || height <= 0), so INVALID_REGION.isEmpty() is TRUE. Testing
+// isEmpty() therefore reads "repaint this entire layer" as "nothing changed" --
+// silent stale pixels. Discriminate on isValid(), which is what Layer.cpp does
+// when it computes isSmallDirty.
+// ===========================================================================
+Region collectEpdcDamage(const Output& output) {
+    // Last frame's coverage per layer, so we can detect movement and removal.
+    // Keyed by output as well: finishFrame runs once per output and outputs do
+    // not share layers. Entries are erased when an output stops appearing.
+    static std::unordered_map<const Output*, std::unordered_map<int32_t, Region>>
+            sPrevCoverage;
+
+    auto& prev = sPrevCoverage[&output];
+    std::unordered_map<int32_t, Region> current;
+    current.reserve(prev.size() + 4);
+
+    Region damage;
+
+    for (const auto* outputLayer : output.getOutputLayersOrderedByZ()) {
+        if (!outputLayer) continue;
+
+        const Region& coverage = outputLayer->getState().outputSpaceVisibleRegion;
+        auto& layerFE = outputLayer->getLayerFE();
+        const int32_t id = layerFE.getSequence();
+        current[id] = coverage;
+
+        // (1) Did the contents change?
+        bool contentChanged;
+        if (const auto* feState = layerFE.getCompositionState()) {
+            const Rect bounds = feState->surfaceDamage.getBounds();
+            // !isValid() is the INVALID_REGION sentinel: the whole layer.
+            contentChanged = !bounds.isValid() || !bounds.isEmpty();
+        } else {
+            // No state to consult. Assume the expensive answer: returning too
+            // much only costs refresh time, returning too little corrupts the
+            // panel until something else happens to repaint that area.
+            contentChanged = true;
+        }
+        if (contentChanged) {
+            damage.orSelf(coverage);
+        }
+
+
+        // (2) Did the coverage change? Both the vacated and the newly occupied
+        // pixels need repainting, and neither shows up in surfaceDamage.
+        const auto it = prev.find(id);
+        if (it == prev.end()) {
+            damage.orSelf(coverage);
+        } else if (!it->second.hasSameRects(coverage)) {
+            damage.orSelf(it->second);
+            damage.orSelf(coverage);
+        }
+    }
+
+    // (3) Layers that existed last frame and do not now. Whatever is behind
+    // them has to be repainted, and this cache is the only remaining record of
+    // where they were.
+    for (const auto& [id, coverage] : prev) {
+        if (current.find(id) == current.end()) {
+            damage.orSelf(coverage);
+        }
+    }
+
+
+    prev = std::move(current);
+
+    // Clip to the panel. A layer can extend past the display edge, and the
+    // kernel rejects an update rectangle that does not fit the plane.
+    damage.andSelf(output.getState().displaySpace.getContent());
+    return damage;
+}
+
+void publishEpdcDamage(const Region& damage, bool forceFull) {
+    auto* s = epdcDamageMap();
+    if (!s) return;
+
+    // Nothing changed: do not advertise a change.
+    //
+    // seq is the reader's change detector -- the shim drives the panel only when
+    // it moves. Publishing an empty region while bumping seq tells the shim
+    // "something changed, but I cannot say what", and its fallback for an
+    // unknown region is the whole panel. So an empty damage region used to cost
+    // a full 1648x824 refresh.
+    //
+    // That was harmless when damage was a single coarse full-panel rectangle,
+    // because it was never empty. With per-layer damage it is empty routinely:
+    // an app whose SurfaceView keeps SurfaceFlinger compositing while none of
+    // its layers actually change produces exactly this. Measured in the Kindle
+    // reader, idle with no input: 20 commits and 2 full-panel refreshes every
+    // five seconds, for a page that was not changing.
+    //
+    // forceFull still publishes, because that is a deliberate request to
+    // repaint (first frame after attach, where what is on the panel is unknown).
+    if (!forceFull && damage.isEmpty()) {
+        return;
+    }
+
+
+    uint32_t n = 0;
+    epdc_damage_rect rects[EPDC_DAMAGE_MAX];
+
+    if (!forceFull) {
+        size_t total = 0;
+        for (auto it = damage.begin(), end = damage.end(); it != end; ++it) {
+            ++total;
+        }
+        if (total > 0 && total <= EPDC_DAMAGE_MAX) {
+            for (auto it = damage.begin(), end = damage.end();
+                 it != end && n < EPDC_DAMAGE_MAX; ++it, ++n) {
+                rects[n] = {it->left, it->top, it->right, it->bottom};
+            }
+        } else if (total > EPDC_DAMAGE_MAX) {
+            // The kernel takes at most EPDC_DAMAGE_MAX rectangles. When the
+            // region is finer than that, collapse to its bounds: an over-large
+            // rectangle only costs refresh time, whereas dropping one leaves
+            // stale pixels on screen.
+            const Rect b = damage.getBounds();
+            rects[0] = {b.left, b.top, b.right, b.bottom};
+            n = 1;
+        }
+    }
+
+    const uint32_t seq = __atomic_load_n(&s->seq, __ATOMIC_RELAXED) + 1;
+    __atomic_store_n(&s->seq, seq, __ATOMIC_RELEASE);      // odd: writing
+    s->count = n;
+    s->full = (forceFull || n == 0) ? 1u : 0u;
+    for (uint32_t i = 0; i < n; i++) {
+        s->rect[i] = rects[i];
+    }
+    __atomic_store_n(&s->seq, seq + 1, __ATOMIC_RELEASE);  // even: stable
+}
+
