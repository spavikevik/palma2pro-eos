# Device-specific dumps. Contain IMEI, serials, DRM/attestation keys, and
# proprietary Onyx blobs. Never commit these.
backup/
firmware/
out/

# Third-party checkouts (bkerler/edl and friends) -- not ours to vendor.
edl/

# Recon output has device identifiers in it; keep it local.
*-recon.txt

*.img
*.bin
*.upx
*.zip
payload.bin

.DS_Store

# onyx-sf branch: proprietary Onyx/Qualcomm prebuilts. Extracted from the
# device we own; NOT redistributable. Never track these.
vendor/onyx-prebuilts/

# Onyx proprietary blobs extracted from the device we own. The kernel is a
# modified Linux for which Onyx publishes no source (their GPL-2.0 violation);
# the dtb/dtbo and vendor bits are proprietary. NOT redistributable -- they were
# purged from git history before this repo was ever pushed. INSTALL.md step 3
# tells you how to extract them from your own device.
device/onyx/*/prebuilt/
